# Supabase 프로젝트 설정 > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 사이드 전용. 절대 클라이언트로 노출 금지.
# 로그인이 없으므로 모든 DB 접근이 이 키(RLS 우회)로 이뤄진다. 반드시 정확히 설정해야 한다.
SUPABASE_SERVICE_ROLE_KEY=

# 예) http://localhost:3000 또는 https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=

# Vercel Cron 인증 시크릿. 크론 엔드포인트(/api/cron/notify)가 검증한다.
CRON_SECRET=

# 앱이 "현재 사용자"로 사용하는 users 프로필 행 id. 미설정 시 seed/마이그레이션 기본값을 사용.
# NEXT_PUBLIC_PROFILE_USER_ID=11111111-1111-1111-1111-111111111111
