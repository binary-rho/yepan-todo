# Supabase 프로젝트 설정 > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 사이드 전용. 절대 클라이언트로 노출 금지 (알림 크론/스토리지 서명 URL 등에서 사용)
SUPABASE_SERVICE_ROLE_KEY=

# 예) http://localhost:3000 또는 https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=

# Vercel Cron 인증 시크릿. 크론 엔드포인트(/api/cron/notify)가 검증한다.
CRON_SECRET=

# 로그인 우회 스위치(개발용). 1 이면 매직 링크 로그인을 건너뛰고 시드 관리자로 바로 접근한다.
# 로그인을 다시 쓰려면 이 줄을 지우거나 0 으로 둔다. (SUPABASE_SERVICE_ROLE_KEY 필요)
NEXT_PUBLIC_AUTH_BYPASS=1
# 우회 시 로그인한 것으로 취급할 사용자 id. 미설정 시 seed.sql 관리자(박지수)를 사용.
# NEXT_PUBLIC_BYPASS_USER_ID=
