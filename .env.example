# Supabase 프로젝트 설정 > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 사이드 전용. 절대 클라이언트로 노출 금지 (알림 크론/스토리지 서명 URL 등에서 사용)
SUPABASE_SERVICE_ROLE_KEY=

# 배포 도메인의 절대 URL. 매직 링크 redirect 와 알림 링크(/tasks/[id])에 사용
# 예) http://localhost:3000 또는 https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=

# 메신저 웹훅 URL. 없으면 알림이 콘솔 출력으로 대체된다.
MESSENGER_WEBHOOK_URL=

# Vercel Cron 인증 시크릿. 크론 엔드포인트(/api/cron/notify)가 검증한다.
CRON_SECRET=
