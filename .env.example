# Supabase 프로젝트 설정 > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 사이드 전용. 절대 클라이언트로 노출 금지.
# 로그인이 없으므로 모든 DB 접근이 이 키(RLS 우회)로 이뤄진다. 반드시 정확히 설정해야 한다.
SUPABASE_SERVICE_ROLE_KEY=

# 예) http://localhost:3000 또는 https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=

# Vercel Cron 인증 시크릿. 크론 엔드포인트(/api/cron/notify)가 검증한다.
CRON_SECRET=

# (선택) 멤버 관리 화면의 "팀즈에서 가져오기" 버튼용 Microsoft Graph 연동.
# 4개 모두 없으면 버튼을 눌러도 실패 메시지만 뜨고, 나머지 기능에는 영향 없다.
# Azure Portal > Entra ID > 앱 등록 에서 발급하며, TeamMember.Read.All 등 앱 권한에 대해
# 테넌트 관리자 동의(admin consent)가 필요하다.
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_TEAM_ID=
